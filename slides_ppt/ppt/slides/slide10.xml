l="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr b="1"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="353" name="Google Shape;353;p29"/><p:cNvSpPr txBox="1"/><p:nvPr><p:ph idx="1" type="body"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="540000" y="1168924"/><a:ext cx="5040000" cy="5040000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr anchorCtr="0" anchor="t" bIns="39900" lIns="79450" spcFirstLastPara="1" rIns="79450" wrap="square" tIns="39900"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="871"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="pt-BR"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>À</a:t></a:r><a:r><a:rPr lang="pt-BR"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:rPr><a:t>s vezes, point update não é suficiente. Queremos poder adicionar um valor à todo mundo no intervalo ou setar um valor pra todo mundo no intervalo. Para isso,  podemos usar uma Seg Lazy (preguiçosa).</a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="871"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr><a:solidFill><a:schemeClr val="dk1"/></a:solidFill></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="354" name="Google Shape;354;p29"/><p:cNvSpPr txBox="1"/><p:nvPr><p:ph idx="2" type="body"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="6598800" y="1170000"/><a:ext cx="5040000" cy="5040000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr anchorCtr="0" anchor="t" bIns="39900" lIns="79450" spcFirstLastPara="1" rIns="79450" wrap="square" tIns="39900"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="871"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="pt-BR"/><a:t>A ideia principal é que não precisamos atualizar todo mundo de uma vez só. Podemos ter updates pendentes em cada nó e, somente quando descermos em uma consulta, propagamos a atualização.</a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="871"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:t></a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l"><a:spcBef><a:spcPts val="871"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="pt-BR"/><a:t>Isso garante que cada update ainda </a:t></a:r><a:r><a:rPr lang="pt-BR"/><a:t>permaneça em O(log N)</a:t></a:r><a:endParaRPr/></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>